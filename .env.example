# PostgreSQL. Përdor përdorues me të drejta minimale (jo superuser) dhe TLS në prodhim.
SMS_DATABASE_URL=postgresql+psycopg://sms:change-me@db:5432/sms?sslmode=require
SMS_ADMIN_API_KEY=change-me-long-random

# Provider HTTP (opsional) dhe sekretet e webhook-ut DLR
SMS_HTTP_PROVIDER_NAME=http
SMS_HTTP_PROVIDER_URL=
SMS_HTTP_PROVIDER_KEY=
SMS_DLR_SECRETS={"http": "change-me"}
SMS_DLR_TIMEOUT_HOURS=72

# Twilio (opsional; shih docs/TWILIO.md)
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_MESSAGING_SERVICE_SID=

# Çelës HMAC për adresat në consent (gjenero: python -c "import secrets;print(secrets.token_hex(32))")
SMS_PII_HMAC_KEY=

# Email
SMS_SECRETS_KEY=            # Fernet: python -c "from cryptography.fernet import Fernet as F;print(F.generate_key().decode())"
SMS_SPF_INCLUDE=spf.your-platform.example
SMS_PUBLIC_BASE_URL=https://api.your-platform.example
SMS_EMAIL_PROVIDER=smtp
SMS_SMTP_HOST=
SMS_SMTP_PORT=587
SMS_SMTP_USER=
SMS_SMTP_PASSWORD=

# --- Prodhim (SMS_ENV=production aktivizon kontrollet e nisjes: aplikacioni refuzon konfigurim të pasigurt)
SMS_ENV=production
POSTGRES_PASSWORD=change-me-long-random      # përdoret nga docker-compose.prod.yml
SMS_TRUSTED_PROXY_HOPS=1                     # nginx i compose vendos X-Forwarded-For
SMS_DEFAULT_LANGUAGE=sq                      # sq | en (faturë, çregjistrim, fundi i emailit)
SMS_REQUIRE_STAFF_2FA=true                   # 2FA për veprimet e ndjeshme të stafit
SMS_PAYMENT_PROVIDER=disabled                # "disabled" derisa të lidhet një gateway i vërtetë (jo "fake")

# M8-c: lejon aplikuesin M7 të krijojë tenant "shell" lokal (id=UUID Central, owner_ref=cp-<uuid>)
# kur vjen gjendje Enterprise e panjohur lokalisht. Çelës i veçantë nga SMS_CP_SYNC_MODE.
SMS_CP_TENANT_AUTOCREATE=false

# M9-c: autoriteti i parave. local (default) = sjellja e sotme · shadow = validim i cutover-it (grant-et e Central
# regjistrohen, s'kreditojnë; mint lokal i ngrirë; baseline lejohet) · central = vetëm grant-et e Central krijojnë
# kredi pozitive. Para `central`: `python -m scripts.money_authority_readiness` duhet PASS; në prodhim vendos
# edhe ACK (si SMS_CP_ENFORCE_READINESS_ACK). Roli i consumer-it: `python -m app.worker --role money_control_plane`
# (çelës klienti me scope `money:read`). Rikthimi central→local = ROLLBACK EMERGJENT (vetëm konfigurim).
SMS_MONEY_AUTHORITY=local
SMS_MONEY_AUTHORITY_ACK=false

# M9-d: raportimi i përdorimit financiar drejt Central (roli `--role money_usage_reporter`; scope `money:report`).
# Opsional në local; i detyrueshëm për SMS_MONEY_AUTHORITY=central në prodhim.
SMS_MONEY_REPORTING=false

# M9-e: autoriteti i ÇMIMEVE të klientit (i pavarur nga SMS_MONEY_AUTHORITY). local (default) = tarifat lokale · shadow = krahason me Central,
# charge me lokalin · central = snapshot-i Central autoritar (nën central: s'ka editim lokal të çmimeve). Para `central`:
# `python -m scripts.pricing_authority_readiness` PASS; në prodhim + SMS_PRICING_AUTHORITY_ACK=true. Roli: `--role pricing_control_plane`.
SMS_PRICING_AUTHORITY=local
SMS_PRICING_AUTHORITY_ACK=false
