# Tabelat e platformës kanë prefiks sms_ dhe nuk prekin tabelat e omnichannel.
SMS_DATABASE_URL=mysql+pymysql://sms:change-me@db:3306/omnichannel_copy?charset=utf8mb4
SMS_ADMIN_API_KEY=change-me-long-random

# Provider HTTP (opsional) dhe sekretet e webhook-ut DLR
SMS_HTTP_PROVIDER_NAME=http
SMS_HTTP_PROVIDER_URL=
SMS_HTTP_PROVIDER_KEY=
SMS_DLR_SECRETS={"http": "change-me"}
SMS_DLR_TIMEOUT_HOURS=72
