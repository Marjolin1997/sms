# PostgreSQL. Përdor përdorues me të drejta minimale (jo superuser) dhe TLS në prodhim.
SMS_DATABASE_URL=postgresql+psycopg://sms:change-me@db:5432/sms?sslmode=require
SMS_ADMIN_API_KEY=change-me-long-random

# Provider HTTP (opsional) dhe sekretet e webhook-ut DLR
SMS_HTTP_PROVIDER_NAME=http
SMS_HTTP_PROVIDER_URL=
SMS_HTTP_PROVIDER_KEY=
SMS_DLR_SECRETS={"http": "change-me"}
SMS_DLR_TIMEOUT_HOURS=72

# Twilio (opsional; shih docs/TWILIO.md)
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_MESSAGING_SERVICE_SID=

# Çelës HMAC për adresat në consent (gjenero: python -c "import secrets;print(secrets.token_hex(32))")
SMS_PII_HMAC_KEY=

# Email
SMS_SECRETS_KEY=            # Fernet: python -c "from cryptography.fernet import Fernet as F;print(F.generate_key().decode())"
SMS_SPF_INCLUDE=spf.your-platform.example
SMS_PUBLIC_BASE_URL=https://api.your-platform.example
SMS_EMAIL_PROVIDER=smtp
SMS_SMTP_HOST=
SMS_SMTP_PORT=587
SMS_SMTP_USER=
SMS_SMTP_PASSWORD=

# --- Prodhim (SMS_ENV=production aktivizon kontrollet e nisjes: aplikacioni refuzon konfigurim të pasigurt)
SMS_ENV=production
POSTGRES_PASSWORD=change-me-long-random      # përdoret nga docker-compose.prod.yml
SMS_TRUSTED_PROXY_HOPS=1                     # nginx i compose vendos X-Forwarded-For
SMS_DEFAULT_LANGUAGE=sq                      # sq | en (faturë, çregjistrim, fundi i emailit)
SMS_REQUIRE_STAFF_2FA=true                   # 2FA për veprimet e ndjeshme të stafit
SMS_PAYMENT_PROVIDER=disabled                # "disabled" derisa të lidhet një gateway i vërtetë (jo "fake")

# M8-c: lejon aplikuesin M7 të krijojë tenant "shell" lokal (id=UUID Central, owner_ref=cp-<uuid>)
# kur vjen gjendje Enterprise e panjohur lokalisht. Çelës i veçantë nga SMS_CP_SYNC_MODE.
SMS_CP_TENANT_AUTOCREATE=false

# M9-c: autoriteti i parave. local (default) = sjellja e sotme · shadow = validim i cutover-it (grant-et e Central
# regjistrohen, s'kreditojnë; mint lokal i ngrirë; baseline lejohet) · central = vetëm grant-et e Central krijojnë
# kredi pozitive. Para `central`: `python -m scripts.money_authority_readiness` duhet PASS; në prodhim vendos
# edhe ACK (si SMS_CP_ENFORCE_READINESS_ACK). Roli i consumer-it: `python -m app.worker --role money_control_plane`
# (çelës klienti me scope `money:read`). Rikthimi central→local = ROLLBACK EMERGJENT (vetëm konfigurim).
SMS_MONEY_AUTHORITY=local
SMS_MONEY_AUTHORITY_ACK=false

# M9-d: raportimi i përdorimit financiar drejt Central (roli `--role money_usage_reporter`; scope `money:report`).
# Opsional në local; i detyrueshëm për SMS_MONEY_AUTHORITY=central në prodhim.
SMS_MONEY_REPORTING=false

# M9-g2: raportimi kumulativ i email-eve të faturueshme drejt Central (roli `--role billing_usage_reporter`; scope `billing:report`).
# Opsional; s'ndikon dërgimin e email-it. Jo-aktiv derisa Central të faturojë këtë enterprise.
SMS_BILLING_USAGE_REPORTING=false

# M9-e: autoriteti i ÇMIMEVE të klientit (i pavarur nga SMS_MONEY_AUTHORITY). local (default) = tarifat lokale · shadow = krahason me Central,
# charge me lokalin · central = snapshot-i Central autoritar (nën central: s'ka editim lokal të çmimeve). Para `central`:
# `python -m scripts.pricing_authority_readiness` PASS; në prodhim + SMS_PRICING_AUTHORITY_ACK=true. Roli: `--role pricing_control_plane`.
SMS_PRICING_AUTHORITY=local
SMS_PRICING_AUTHORITY_ACK=false

# --- Lidhja me Central (e përbashkët për TË GJITHA rolet CP: control_plane, money_*, billing_*, pricing_*, sender_*). HTTPS i detyrueshëm në prodhim për çdo rol të aktivizuar.
# Çelësi privat Ed25519 mountohet nga compose te /run/secrets/cp_private_key (SMS_CP_PRIVATE_KEY_PATH vendoset aty); KURRË në .env/git.
SMS_CP_BASE_URL=
SMS_CP_CLIENT_ID=
SMS_CP_KEY_ID=
SMS_CP_REQUEST_TIMEOUT_SECONDS=10

# M10 Sender Policy. Autoriteti: local (default, sjellja e sotme) · shadow (krahason me projeksionin, pa efekt te klienti) · central (vendos projeksioni; NUK aktivizohet pa prova — docs/M10_SENDER_RUNBOOK.md).
# Mos e kalo në shadow/central thjesht sepse workerat po punojnë. Rendi: kredenciale `sender:read`+`sender:report` → SYNC/REPORTING → workerat (`--profile sender`) → shëndet S2/S3 → bootstrap dry-run → vetëm më pas shadow.
SMS_SENDER_AUTHORITY=local
# ACK i prodhimit për central = `evidence_hash` (64 hex) nga `python -m scripts.sender_cutover evidence`; bosh = pa ACK.
SMS_SENDER_AUTHORITY_ACK=
# Sinkronizimi i projeksionit (roli sender_control_plane; compose: sender-sync) dhe raportimi i kërkesave (roli sender_request_reporter; compose: sender-report). Të dyja false = proces boshe.
SMS_SENDER_SYNC_ENABLED=false
SMS_SENDER_POLL_INTERVAL_SECONDS=30
SMS_SENDER_SNAPSHOT_INTERVAL_SECONDS=3600
SMS_SENDER_REQUEST_REPORTING=false
# M11-D2: snapshot operacional drejt Central (i njëjti proces `sender-report`; scope sender:report). Parazgjedhje e fikur; kur aktivizohet Central tregon provën reale të Enterprise.
SMS_SENDER_OPS_REPORTING=false
SMS_SENDER_OPS_INTERVAL_SECONDS=60
SMS_SENDER_REQUEST_INTERVAL_SECONDS=30
SMS_SENDER_REQUEST_ALERT_AGE_SECONDS=900
# Rikontrolli para provider-it për mesazhet e autorizuara nga Central (kërkohet true për central).
SMS_SENDER_DISPATCH_RECHECK=true
# Prova shadow: përqindja e përputhjeve që ruhen (mospërputhjet ruhen gjithmonë), mosha pas së cilës projeksioni raportohet "stale" (vetëm raportim), mostra minimale për gatishmëri.
SMS_SENDER_SHADOW_SAMPLE_PCT=10
SMS_SENDER_PROJECTION_FRESH_SECONDS=3600
SMS_SENDER_EVIDENCE_MIN_SAMPLES=100

# M9-f: pragje alarmi financiar + retention operacional (vetëm mjetet `scripts.financial_ops` / `scripts.financial_retention`;
# retention është dry-run nga parazgjedhja dhe 0 = pa fshirje). Shih docs/M9_MONEY_AUDIT.md (M9-f) dhe docs/M9_PRODUCTION_CHECKLIST.md.
SMS_FINANCIAL_UNKNOWN_WARN_SECONDS=3600
SMS_FINANCIAL_MONEY_CURSOR_WARN_SECONDS=900
SMS_FINANCIAL_MONEY_CURSOR_CRITICAL_SECONDS=3600
SMS_FINANCIAL_UNRESOLVED_REVERSAL_CRITICAL_SECONDS=3600
SMS_PRICING_COMPARISON_OK_DAYS=90
SMS_PRICING_COMPARISON_MISMATCH_DAYS=365
SMS_USAGE_OUTBOX_RETENTION_DAYS=0
