# Central (staf admin/operator) — M11-I/F-01. Kopjoje si `.env.central` (jashtë git, leje 600) dhe plotëso sekrete të VËRTETA.
# Skedar i NDARË nga `.env` të Enterprise: asnjë sekret/DB i përbashkët. Kërkohet VETËM kur aktivizohet Central (`--profile central` / `central-jobs`); `docker compose up -d` i zakonshëm (vetëm-Enterprise) nuk e kërkon. Vlerat më poshtë janë vetëm placeholder-a/default-e të sigurta.
# Të gjitha emrat kanë prefiksin CENTRAL_ (apps/central/core/config.py). Nisja në prodhim REFUZOHET kur gate-t e sigurisë shkelen.

# --- Mjedisi dhe baza e të dhënave ---
# `production` aktivizon gate-t e nisjes: CENTRAL_AUTH_SECRET >= 32 karaktere, PostgreSQL (SQLite refuzohet),
# mailer/bot-challenge jo `fake`, auto-regjistrim i paverifikuar = false.
CENTRAL_ENV=production
# DB logjike e VEÇANTË `sms_central` (jo `sms` e Enterprise), rol i veçantë. KRIJIMI I SAJ ËSHTË HAP INFRASTRUKTURE (runbook), jo i aplikacionit.
# Migrimi `central-migrate` refuzon të ekzekutohet mbi një DB Enterprise (gjen `sms_alembic_version`).
CENTRAL_DATABASE_URL=postgresql+psycopg://sms_central:CHANGE_ME@db:5432/sms_central
# CENTRAL_DB_POOL_SIZE=5
# CENTRAL_DB_STATEMENT_TIMEOUT_MS=30000

# --- Autentikimi i stafit (JWT HS256) ---
# Gjenero: python -c "import secrets;print(secrets.token_hex(32))" — bosh/<32 karaktere = nisja në prodhim refuzohet.
CENTRAL_AUTH_SECRET=
CENTRAL_AUTH_TTL_SECONDS=900

# --- IP e klientit pas proxy-t ---
# 1 = `central-web` (nginx i compose) shkruan X-Forwarded-For me IP-në e lidhjes. Me load balancer para tij: blloku i veçantë "TLS / reverse proxy".
CENTRAL_TRUSTED_PROXY_HOPS=1

# --- Regjistrimi publik i tenant-ëve (M8) ---
# `central-web` NUK ruton /registration* (404): regjistrimi publik mbetet i mbyllur. Mos e hap pa blloqet e proxy-t, mailer-it dhe CAPTCHA-s reale.
CENTRAL_PUBLIC_REGISTRATION_ENABLED=false
# Prodhimi refuzon `true`.
CENTRAL_ALLOW_UNVERIFIED_AUTO_REGISTRATION=false
# CENTRAL_PUBLIC_REGISTRATION_MAX_PER_EMAIL_24H=3
# Mos e vendos `true` derisa proxy-ja real të ketë kufijtë për /registration* (ky nginx s'e ruton).
CENTRAL_PUBLIC_REGISTRATION_PROXY_ACK=false
CENTRAL_PUBLIC_REGISTRATION_REQUIRE_CHALLENGE=false
# `disabled` në prodhim (adapter real i CAPTCHA-s s'ekziston ende); `fake` refuzohet në prodhim.
CENTRAL_BOT_CHALLENGE=disabled
CENTRAL_REGISTRATION_VERIFY_KEY=
# CENTRAL_REGISTRATION_VERIFY_TTL_MINUTES=60
CENTRAL_REGISTRATION_VERIFY_URL_BASE=

# --- Email i Central (verifikim regjistrimi) ---
# `disabled` | `smtp` (`fake` refuzohet në prodhim). Proces: python -m apps.central.tools.send_notifications (profili central-jobs).
CENTRAL_MAILER=disabled
CENTRAL_SMTP_HOST=
CENTRAL_SMTP_PORT=587
CENTRAL_SMTP_USER=
CENTRAL_SMTP_PASSWORD=
CENTRAL_SMTP_STARTTLS=true
CENTRAL_SMTP_FROM=

# --- Faturimi periodik (M9-g) ---
# Konfirmim operativ që `billing_run` është PLANIFIKUAR jashtë Central (cron/systemd -> `docker compose run central-billing-run`). Mos e vendos true pa planifikim real.
CENTRAL_BILLING_WORKER_CONFIGURED=false
CENTRAL_ISSUER_NAME=Your Company Ltd
CENTRAL_ISSUER_ADDRESS=Street 1, City, Country
CENTRAL_ISSUER_TAX_ID=
CENTRAL_INVOICE_DUE_DAYS=14
# CENTRAL_BILLING_SHADOW_AMOUNT_TOLERANCE=0
# CENTRAL_BILLING_RUN_STALE_SECONDS=93600
# CENTRAL_BILLING_USAGE_FRESH_SECONDS=900
# CENTRAL_BILLING_USAGE_STALE_SECONDS=7200
# CENTRAL_BILLING_WAIT_WARN_SECONDS=3600
# CENTRAL_BILLING_WAIT_FAIL_SECONDS=86400

# --- Gatishmëria dhe rakordimi (pragje vëzhgimi; default-et janë të verifikuara) ---
# CENTRAL_SENDER_OPS_STALE_SECONDS=300
# CENTRAL_MONEY_REPORT_FRESH_SECONDS=600
# CENTRAL_MONEY_REPORT_STALE_SECONDS=1800
# CENTRAL_MONEY_CURSOR_LAG_GRACE_SECONDS=900
# CENTRAL_MONEY_CURSOR_STALE_WARN_SECONDS=900
# CENTRAL_MONEY_CURSOR_STALE_FAIL_SECONDS=3600
# CENTRAL_MONEY_UNRESOLVED_REVERSAL_FAIL_SECONDS=3600
# CENTRAL_MONEY_REPORT_MISSING_GRACE_SECONDS=1800
# CENTRAL_PAYMENT_PENDING_STALE_SECONDS=172800

# --- Retention i raporteve të përdorimit (0 = pa fshirje; vendim ligjor para ndryshimit) ---
# CENTRAL_USAGE_REPORT_RETENTION_DAYS=0
# CENTRAL_USAGE_REPORT_FULL_DAYS=30
# CENTRAL_USAGE_REPORT_KEEP_LAST=20
